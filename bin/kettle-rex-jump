#!/bin/bash
# Show a Rex block in rex-gui, then print the window address to raise.
#
#   kettle-rex-jump SESSION BLOCK [SERVER] [SSH_HOST]
#
# A Rex pane never surfaces its OSC 2 title as an OS window title, so the
# title nonce cannot find it. The pane's own REX_SESSION and REX_BLOCK can:
# the app client is told to show the session and the server to focus the
# block, both through the rex CLI.
#
# SERVER is what the remote reported about itself, so it is never connected
# to directly. It selects one of the remote hosts rex-gui already has, and
# that configured address is what rex dials. Empty SERVER and SSH_HOST means
# the local server.

set -uo pipefail

session=${1:-} block=${2:-} server=${3:-} ssh_host=${4:-}
uuid='[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'
[[ $session =~ ^session:$uuid$ && $block =~ ^block:$uuid$ ]] || { echo "kettle-rex-jump: bad target" >&2; exit 2; }

command -v rex >/dev/null 2>&1 || { echo "kettle-rex-jump: rex is not on PATH" >&2; exit 3; }
settings="${XDG_CONFIG_HOME:-$HOME/.config}/rex-gui/settings.json"

# Prints the configured address on line one and client_label on line two.
picked=$(python3 -I - "$settings" "$server" "$ssh_host" <<'PY'
import json, re, sys
path, server, ssh_host = sys.argv[1], sys.argv[2].lower().rstrip("."), sys.argv[3].lower()
try:
    s = json.load(open(path))
except Exception:
    s = {}

def bare(addr):
    a = re.sub(r"^[a-z]+://", "", addr.strip().lower())
    a = a.split("/")[0].split("@")[-1]
    return re.sub(r":\d+$", "", a).rstrip(".")

addr = ""
if server or ssh_host:
    for h in s.get("remote_hosts") or []:
        a = str(h.get("address") or "")
        if server and bare(a) == server:
            addr = a; break
        if ssh_host and a.lower().startswith("ssh://") and bare(a) == ssh_host:
            addr = a; break
    if not addr:
        sys.exit(4)
print(addr)
print(str(s.get("client_label") or "").strip())
PY
)
case $? in
  0) ;;
  4) echo "kettle-rex-jump: ${server:-$ssh_host} is not one of rex-gui's remote hosts" >&2; exit 4 ;;
  *) exit 1 ;;
esac
addr=$(sed -n 1p <<< "$picked")
label=$(sed -n 2p <<< "$picked")

rex_s=(rex --autostart=false --timeout 3s)
[[ -n $addr ]] && rex_s+=(-S "$addr")

# Without a label, find this machine's app client: over tailscale it is named
# by node, over a local socket by pid. Several matches is a refusal, since
# driving someone else's window is worse than driving none.
client=$label
if [[ -z $client ]]; then
  clients=$("${rex_s[@]}" client ls --json 2>/dev/null) || clients=""
  client=$(python3 -I - "$clients" "$(hostname)" "$(pgrep -x rex-gui | tr '\n' ' ')" <<'PY'
import json, sys
try:
    cs = json.loads(sys.argv[1]).get("clients") or []
except Exception:
    cs = []
node, pids = sys.argv[2].split(".")[0].lower(), {int(p) for p in sys.argv[3].split()}
apps = [c for c in cs if (c.get("info") or {}).get("kind") == "app"
        and c.get("connection_state", "connected") == "connected"]
mine = [c for c in apps
        if str((c.get("principal") or {}).get("node", "")).lower() == node
        or (c.get("principal") or {}).get("pid") in pids]
if len(mine) == 1:
    print(mine[0]["client_id"])
PY
)
fi

if [[ -z $client ]]; then
  # No window of ours is attached there. Opening one on the session is the
  # same destination, reached the slow way.
  if command -v rex-gui >/dev/null 2>&1 && ! pgrep -x rex-gui >/dev/null; then
    setsid -f rex-gui ${addr:+-S "$addr"} "$session" >/dev/null 2>&1 </dev/null
    exit 0
  fi
  echo "kettle-rex-jump: no rex-gui client of this machine is connected to ${addr:-the local server}" >&2
  exit 5
fi

# Independent requests, one round trip each over tailscale (~0.8s measured
# with `time`), so they run side by side.
"${rex_s[@]}" -C "$client" do session.select session_id="$session" >/dev/null 2>&1 & sel=$!
"${rex_s[@]}" -C "$client" focus "$block" -s "$session" >/dev/null 2>&1 & foc=$!
wait $sel; s1=$?
wait $foc; s2=$?
(( s1 == 0 )) || { echo "kettle-rex-jump: rex-gui would not show $session" >&2; exit 6; }
(( s2 == 0 )) || echo "kettle-rex-jump: could not focus $block" >&2

# rex-gui's windows all share its pid; the most recently focused one is the
# one the user last looked at.
hyprctl clients -j 2>/dev/null | python3 -I -c '
import json, sys
pids = {int(p) for p in sys.argv[1].split()}
try: cs = json.load(sys.stdin)
except Exception: sys.exit(0)
hits = sorted((c for c in cs if c.get("pid") in pids), key=lambda c: c.get("focusHistoryID", 1 << 30))
if hits: print(hits[0]["address"])
' "$(pgrep -x rex-gui | tr '\n' ' ')"
exit 0
