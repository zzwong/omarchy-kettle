#!/bin/bash
# Kettle installer — wires the agent hook into every supported CLI it finds:
# Claude Code, Codex, Qwen Code, Gemini CLI, Factory droid, Grok Build, and pi
# (which takes an extension rather than a hook).
#
# The hook configs need an absolute path to kettle-agent-hook, which depends on
# where the plugin was cloned. Hand-editing JSON files is a poor first run,
# so this resolves the path and merges the entries idempotently.
#
#   kettle-install            install hooks for every agent found
#   kettle-install --check    report status, change nothing
#   kettle-install --remove   remove Kettle's hook entries

set -uo pipefail

HOOK="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/kettle-agent-hook"
CLAUDE_SETTINGS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
CODEX_HOOKS="${CODEX_HOME:-$HOME/.codex}/hooks.json"
QWEN_SETTINGS="${QWEN_HOME:-$HOME/.qwen}/settings.json"
GEMINI_SETTINGS="$HOME/.gemini/settings.json"
FACTORY_HOOKS="$HOME/.factory/hooks.json"
GROK_HOOK_FILE="$HOME/.grok/hooks/kettle.json"
PI_SETTINGS="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/settings.json"
PI_EXTENSION="$(cd "$(dirname "${BASH_SOURCE[0]}")/../pi" && pwd)/kettle.ts"

# Per-tool event vocabularies. Claude fires Notification for both permission
# gates and the idle nudge (the hook tells them apart); Codex and Qwen have an
# explicit PermissionRequest; Gemini renamed the prompt/turn pair; Grok's
# Notification payload is undocumented, so it is left unwired — a silent
# permission wait stays "simmering" rather than turning falsely "ready".
CLAUDE_EVENTS=(SessionStart UserPromptSubmit Notification Stop SessionEnd)
CODEX_EVENTS=(SessionStart UserPromptSubmit PermissionRequest Stop SessionEnd)
QWEN_EVENTS=(SessionStart UserPromptSubmit PermissionRequest Stop SessionEnd)
GEMINI_EVENTS=(SessionStart BeforeAgent Notification AfterAgent SessionEnd)
FACTORY_EVENTS=(SessionStart UserPromptSubmit Notification Stop SessionEnd)
GROK_EVENTS=(SessionStart UserPromptSubmit Stop SessionEnd)

mode=install
case "${1:-}" in
  --check)  mode=check ;;
  --remove) mode=remove ;;
  --help|-h)
    sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'
    exit 0 ;;
  "") ;;
  *) echo "unknown option: $1" >&2; exit 2 ;;
esac

[[ -x $HOOK ]] || { echo "kettle-agent-hook not executable at $HOOK" >&2; exit 1; }

# merge <file> <mode> <hook> <style> <unit> <async> <events...>
#   style: "wrapped" nests events under a "hooks" key (Claude, Codex, Qwen,
#          Gemini, Grok); "bare" puts event names at the top level (droid's
#          hooks.json — verified at docs.factory.ai).
#   unit:  "s" or "ms". Qwen and Gemini timeouts are MILLISECONDS — writing
#          Claude's 5 there would give the hook five milliseconds to live.
#   async: "yes" writes "async": true; tools whose schema lacks the field
#          (Gemini, droid, Grok) get "no" rather than an unknown key. The
#          hook backgrounds itself either way, so sync execution is cheap.
merge() {
  local file=$1 mode=$2 hook=$3 style=$4 unit=$5 use_async=$6; shift 6
  python3 - "$file" "$mode" "$hook" "$style" "$unit" "$use_async" "$@" <<'PY'
import json, os, sys

path, mode, hook, style, unit, use_async, *events = sys.argv[1:]

if os.path.exists(path):
    try:
        with open(path) as f:
            doc = json.load(f)
    except json.JSONDecodeError as e:
        print(f"  ! {path} is not valid JSON ({e}); refusing to touch it")
        sys.exit(1)
else:
    doc = {}

hooks = doc if style == "bare" else doc.setdefault("hooks", {})
changed = False

def entries_for(event):
    return hooks.setdefault(event, [])

def is_ours(entry):
    return any(h.get("command") == hook for h in entry.get("hooks", []))

for event in events:
    group = entries_for(event)
    present = any(is_ours(e) for e in group)

    if mode == "remove":
        kept = [e for e in group if not is_ours(e)]
        if len(kept) != len(group):
            changed = True
            if kept:
                hooks[event] = kept
            else:
                del hooks[event]
        continue

    if mode == "check":
        print(f"  {event:<18} {'ok' if present else 'MISSING'}")
        continue

    if present:
        continue

    # Never blocking: these hooks only report state, so a slow or dead
    # listener must not stall the agent's prompt.
    seconds = 10 if event == "SessionStart" else 5
    entry = {
        "type": "command",
        "command": hook,
        "timeout": seconds * 1000 if unit == "ms" else seconds,
    }
    if use_async == "yes":
        entry["async"] = True
    group.append({"hooks": [entry]})
    changed = True

if mode == "check":
    sys.exit(0)

if style != "bare" and not hooks:
    doc.pop("hooks", None)

if changed:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".kettle-tmp"
    with open(tmp, "w") as f:
        json.dump(doc, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)
    print(f"  {'removed from' if mode == 'remove' else 'wrote'} {path}")
else:
    print(f"  {path} already up to date")
PY
}

# Grok Build reads every *.json under ~/.grok/hooks/, so Kettle owns a whole
# file there instead of merging into someone else's — install writes it,
# remove deletes it, and no user config is ever touched.
grok_file() {
  local mode=$1
  case $mode in
    check)
      [[ -f $GROK_HOOK_FILE ]] && echo "  hook file           ok" \
                               || echo "  hook file           MISSING" ;;
    remove)
      if [[ -f $GROK_HOOK_FILE ]]; then
        rm -f "$GROK_HOOK_FILE"
        echo "  removed $GROK_HOOK_FILE"
      else
        echo "  $GROK_HOOK_FILE already absent"
      fi ;;
    install)
      mkdir -p "$(dirname "$GROK_HOOK_FILE")"
      python3 - "$GROK_HOOK_FILE" "$HOOK" "${GROK_EVENTS[@]}" <<'PY'
import json, sys
path, hook, *events = sys.argv[1:]
doc = {"hooks": {
    ev: [{"hooks": [{"type": "command", "command": hook,
                     "timeout": 10 if ev == "SessionStart" else 5}]}]
    for ev in events
}}
with open(path, "w") as f:
    json.dump(doc, f, indent=2)
    f.write("\n")
print(f"  wrote {path}")
PY
      ;;
  esac
}

# pi has no hook config — it loads TypeScript extensions instead — so Kettle
# registers the extension's path in pi's settings.json rather than merging hook
# entries. Referenced by path, not copied, so `omarchy plugin update` moves the
# extension forward the same way it does the hook.
pi_extension() {
  local mode=$1
  [[ $mode == check ]] && {
    python3 - "$PI_SETTINGS" "$PI_EXTENSION" <<'PY'
import json, os, sys
path, ext = sys.argv[1:]
try:
    doc = json.load(open(path))
except Exception:
    doc = {}
present = ext in (doc.get("extensions") or [])
print(f"  extension           {'ok' if present else 'MISSING'}")
print("" if os.path.exists(ext) else f"  ! {ext} is missing from the plugin")
PY
    return
  }
  mkdir -p "$(dirname "$PI_SETTINGS")"
  python3 - "$PI_SETTINGS" "$PI_EXTENSION" "$mode" <<'PY'
import json, os, sys
path, ext, mode = sys.argv[1:]
doc = {}
if os.path.exists(path):
    try:
        doc = json.load(open(path))
    except Exception:
        print(f"  ! {path} is not valid JSON; skipped")
        sys.exit(0)
    # Keep a copy before touching a file we did not write.
    try:
        with open(path + ".kettle-bak", "w") as b: json.dump(doc, b, indent=2)
    except Exception: pass
exts = list(doc.get("extensions") or [])
if mode == "install":
    if ext in exts:
        print(f"  {path} already up to date")
        sys.exit(0)
    exts.append(ext)
else:
    if ext not in exts:
        print(f"  {path} already clean")
        sys.exit(0)
    exts = [e for e in exts if e != ext]
if exts:
    doc["extensions"] = exts
else:
    doc.pop("extensions", None)
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "w") as f:
    json.dump(doc, f, indent=2)
    f.write("\n")
print(f"  {'wrote' if mode == 'install' else 'cleaned'} {path}")
PY
}

echo "Kettle hook: $HOOK"

# target <label> <binary> <config> <style> <unit> <async> <events...>
target() {
  local label=$1 bin=$2 file=$3 style=$4 unit=$5 use_async=$6; shift 6
  if command -v "$bin" >/dev/null 2>&1 || [[ -e $file ]]; then
    echo "$label:"
    merge "$file" "$mode" "$HOOK" "$style" "$unit" "$use_async" "$@"
  else
    echo "$label: not found, skipping"
  fi
}

target "Claude Code"   claude "$CLAUDE_SETTINGS" wrapped s  yes "${CLAUDE_EVENTS[@]}"
target "Codex"         codex  "$CODEX_HOOKS"     wrapped s  yes "${CODEX_EVENTS[@]}"
target "Qwen Code"     qwen   "$QWEN_SETTINGS"   wrapped ms yes "${QWEN_EVENTS[@]}"
target "Gemini CLI"    gemini "$GEMINI_SETTINGS" wrapped ms no  "${GEMINI_EVENTS[@]}"
target "Factory droid" droid  "$FACTORY_HOOKS"   bare    s  no  "${FACTORY_EVENTS[@]}"

if command -v grok >/dev/null 2>&1 || [[ -d $HOME/.grok ]]; then
  echo "Grok Build:"
  grok_file "$mode"
else
  echo "Grok Build: not found, skipping"
fi

if command -v pi >/dev/null 2>&1 || [[ -d ${PI_CODING_AGENT_DIR:-$HOME/.pi/agent} ]]; then
  echo "pi:"
  pi_extension "$mode"
else
  echo "pi: not found, skipping"
fi

if [[ $mode == install ]]; then
  cat <<EOF

Next:
  omarchy plugin enable zzwong.kettle right

herdr sessions need no setup at all. Agent sessions outside herdr pick the
hooks up on their next event; sessions already running when you installed
will resolve themselves on their next prompt.
EOF
fi
