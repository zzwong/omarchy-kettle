#!/bin/bash
# Kettle installer — wires the agent hooks into Claude Code and Codex.
#
# The hook configs need an absolute path to kettle-agent-hook, which depends on
# where the plugin was cloned. Hand-editing two JSON files is a poor first run,
# so this resolves the path and merges the entries idempotently.
#
#   kettle-install            install hooks for every agent found
#   kettle-install --check    report status, change nothing
#   kettle-install --remove   remove Kettle's hook entries

set -uo pipefail

HOOK="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/kettle-agent-hook"
CLAUDE_SETTINGS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
CODEX_HOOKS="${CODEX_HOME:-$HOME/.codex}/hooks.json"

# Claude fires Notification for both permission gates and the idle nudge, and
# the hook tells them apart by message. Codex has no Notification event and
# uses PermissionRequest instead.
CLAUDE_EVENTS=(SessionStart UserPromptSubmit Notification Stop SessionEnd)
CODEX_EVENTS=(SessionStart UserPromptSubmit PermissionRequest Stop SessionEnd)

mode=install
case "${1:-}" in
  --check)  mode=check ;;
  --remove) mode=remove ;;
  --help|-h)
    sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'
    exit 0 ;;
  "") ;;
  *) echo "unknown option: $1" >&2; exit 2 ;;
esac

[[ -x $HOOK ]] || { echo "kettle-agent-hook not executable at $HOOK" >&2; exit 1; }

merge() {
  local file=$1 mode=$2 hook=$3; shift 3
  python3 - "$file" "$mode" "$hook" "$@" <<'PY'
import json, os, sys

path, mode, hook, *events = sys.argv[1:]

if os.path.exists(path):
    try:
        with open(path) as f:
            doc = json.load(f)
    except json.JSONDecodeError as e:
        print(f"  ! {path} is not valid JSON ({e}); refusing to touch it")
        sys.exit(1)
else:
    doc = {}

hooks = doc.setdefault("hooks", {})
changed = False

def entries_for(event):
    return hooks.setdefault(event, [])

def is_ours(entry):
    return any(h.get("command") == hook for h in entry.get("hooks", []))

for event in events:
    group = entries_for(event)
    present = any(is_ours(e) for e in group)

    if mode == "remove":
        kept = [e for e in group if not is_ours(e)]
        if len(kept) != len(group):
            changed = True
            if kept:
                hooks[event] = kept
            else:
                del hooks[event]
        continue

    if mode == "check":
        print(f"  {event:<18} {'ok' if present else 'MISSING'}")
        continue

    if present:
        continue

    # Never blocking: these hooks only report state, so a slow or dead
    # listener must not stall the agent's prompt.
    group.append({
        "hooks": [{
            "type": "command",
            "command": hook,
            "async": True,
            "timeout": 10 if event == "SessionStart" else 5,
        }]
    })
    changed = True

if mode == "check":
    sys.exit(0)

if not hooks:
    doc.pop("hooks", None)

if changed:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".kettle-tmp"
    with open(tmp, "w") as f:
        json.dump(doc, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)
    print(f"  {'removed from' if mode == 'remove' else 'wrote'} {path}")
else:
    print(f"  {path} already up to date")
PY
}

echo "Kettle hook: $HOOK"

if command -v claude >/dev/null 2>&1 || [[ -e $CLAUDE_SETTINGS ]]; then
  echo "Claude Code:"
  merge "$CLAUDE_SETTINGS" "$mode" "$HOOK" "${CLAUDE_EVENTS[@]}"
else
  echo "Claude Code: not found, skipping"
fi

if command -v codex >/dev/null 2>&1 || [[ -e $CODEX_HOOKS ]]; then
  echo "Codex:"
  merge "$CODEX_HOOKS" "$mode" "$HOOK" "${CODEX_EVENTS[@]}"
else
  echo "Codex: not found, skipping"
fi

if [[ $mode == install ]]; then
  cat <<EOF

Next:
  omarchy plugin enable kettle right

herdr sessions need no setup at all. Agent sessions outside herdr pick the
hooks up on their next event; sessions already running when you installed
will resolve themselves on their next prompt.
EOF
fi
