#!/usr/bin/env python3
"""Open a local Codex desktop chat and print its window address for the panel."""

import json
import re
import subprocess
import sys
import time


def hypr_json(command):
    result = subprocess.run(
        ["hyprctl", command, "-j"], capture_output=True, text=True, timeout=2, check=True
    )
    return json.loads(result.stdout)


def main():
    if len(sys.argv) != 2 or not re.fullmatch(
        r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}", sys.argv[1]
    ):
        raise ValueError("invalid desktop thread UUID")

    # Use the registered URL handler rather than starting another app-server:
    # thread/resume controls a backend conversation, not the desktop selection.
    subprocess.run(
        ["xdg-open", "codex://threads/" + sys.argv[1]],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5, check=True,
    )
    # Wayland activation may leave the app on another workspace. The panel
    # raises it with its existing focus dispatcher and cursor preservation.
    # Multiple windows require an active app window; never pick an arbitrary
    # chat window. Retry only on a click, while the URL handler is activating.
    for _ in range(20):
        clients = hypr_json("clients")
        hits = [c for c in clients if (c.get("class") or "").lower() in ("chatgpt", "codex")]
        address = ""
        if len(hits) == 1:
            address = hits[0].get("address", "")
        elif hits:
            active = hypr_json("activewindow").get("address", "")
            if any(c.get("address") == active for c in hits):
                address = active
        if re.fullmatch(r"0x[0-9a-fA-F]{1,16}", str(address)):
            print(address)
            return
        time.sleep(0.05)
    raise ValueError("cannot identify the Codex desktop window")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print("kettle: " + str(error), file=sys.stderr)
        sys.exit(1)
