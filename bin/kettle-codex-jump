#!/usr/bin/env python3
"""Codex's existing-chat URL adapter; opened receipt, not a selection receipt."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from kettle_navigation import NavigationError, fullmatch, serve


def open_chat(runner, target):
    classes = ("chatgpt", "codex")
    # Backend resume controls execution, not selection of an existing UI chat.
    runner.command(["xdg-open", "codex://threads/" + target["threadId"]], cap=4096, limit=5)
    for _ in range(15):
        clients = runner.compositor("clients")
        hits = [c for c in clients if isinstance(c, dict)
                and str(c.get("class", "")).lower() in classes]
        address = ""
        if len(hits) == 1:
            address = hits[0].get("address", "")
        elif hits:
            active = runner.compositor("activewindow").get("address", "")
            if any(c.get("address") == active for c in hits):
                address = active
        if fullmatch(r"0x[0-9a-fA-F]{1,16}", address):
            runner.focus(address, classes)
            return address.lower()
        runner.pause()
    raise NavigationError("window-ambiguous" if hits else "app-unavailable")


if __name__ == "__main__":
    sys.exit(serve(sys.argv, "codex-desktop",
                  r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}", open_chat))
