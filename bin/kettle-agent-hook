#!/bin/bash
# Kettle agent hook — bridges a Claude Code session into the Kettle bar widget.
#
# Wired into ~/.claude/settings.json for SessionStart, UserPromptSubmit,
# Notification, Stop and SessionEnd. Reads the hook payload as JSON on stdin
# and forwards a normalised event to the widget over Omarchy shell IPC.
#
# Why this exists: agents running outside herdr are invisible to Kettle, and
# nothing external can observe a terminal it does not own — OSC sequences flow
# from the child process to the terminal emulator and stop there. The agent
# telling us directly is the only honest source of state.
#
# The one exception is OSC 2: setting the window title has an externally
# visible side effect, because the terminal republishes it to the compositor.
# That is how a session identifies its own window even under
# `ghostty --gtk-single-instance`, where every window shares one PID and the
# process tree is useless. Verified: a title nonce resolves in ~400ms.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/kettle/sessions"

payload=$(cat)
[[ -z $payload ]] && exit 0

# Unit separator, NOT tab: bash treats space/tab/newline in IFS as "IFS
# whitespace" and collapses runs of them, so an empty field (a payload with no
# message) would silently shift every later field left by one.
IFS=$'\x1f' read -r event sid cwd message agent_type transcript payload_model < <(
  printf '%s' "$payload" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
def g(k):
    v = d.get(k) or ""
    return str(v).replace("\x1f", " ").replace("\n", " ")
print("\x1f".join([g("hook_event_name"), g("session_id"), g("cwd"), g("message"), g("agent_type"), g("transcript_path"), g("model")]))
' 2>/dev/null
)

[[ -z ${event:-} || -z ${sid:-} ]] && exit 0

# The session id becomes a filename in STATE_DIR and a title nonce. The relay
# validates this charset on its side; the local paths get the same guard, so a
# hostile payload cannot write outside the state dir or smuggle quoting.
[[ $sid =~ ^[A-Za-z0-9._-]{1,64}$ ]] || exit 0

# herdr already reports this session with a richer lifecycle than hooks can
# give us, so a herdr-managed pane must not produce a second pot.
[[ -n ${HERDR_PANE_ID:-} || ${HERDR_ENV:-} == 1 ]] && exit 0

# Claude Code and Codex share this wire format, but not every event name:
# Codex has no Notification event and signals a waiting prompt with
# PermissionRequest instead. Both casings are accepted because the two tools
# spell event names differently in config (kebab) and payload (Pascal).
case ${event,,} in
  sessionstart|session-start)               state="register" ;;
  userpromptsubmit|user-prompt-submit)      state="working"  ;;
  permissionrequest|permission-request) state="blocked" ;;
  notification)
    # Claude Code fires Notification for two unrelated things and only the
    # message tells them apart: a real permission gate, or the idle nudge
    # after a finished turn. Calling the second one "needs approval" claims
    # the agent is blocked when it is simply done.
    if [[ ${message,,} == *permission* || ${message,,} == *approval* ]]; then
      state="blocked"
    else
      state="finished"
    fi
    ;;
  stop)                                     state="finished" ;;
  sessionend|session-end)                   state="gone"     ;;
  *)                                        exit 0 ;;
esac

# Label the pot by whichever agent actually produced the event. Codex sends
# no agent_type at all (verified against codex-cli 0.149.1 by capturing live
# payloads), so an absent field falls through to the transcript's shape:
# Codex transcripts are sessions/…/rollout-*.jsonl, which survives a custom
# CODEX_HOME, where Claude's are <uuid>.jsonl under ~/.claude.
agent=${agent_type:-}
case ${agent,,} in
  *codex*)  agent="codex"  ;;
  *claude*) agent="claude" ;;
  *)
    case ${transcript:-} in
      */rollout-*.jsonl|*/.codex/*) agent="codex"  ;;
      *)                            agent="claude" ;;
    esac ;;
esac

# Remote mode is switched on by the presence of a relay config, which only
# `kettle-remote install` writes. On a remote host there is no omarchy-shell
# and no hyprctl: the local relay resolves the window and computes focus, and
# this side only announces itself and posts the event.
RELAY_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/kettle/relay.conf"
REMOTE=0
if [[ ! -x $(command -v omarchy-shell 2>/dev/null || echo /nonexistent) && -f $RELAY_CONF ]]; then
  REMOTE=1
  relay_port=$(sed -n 's/^port=//p' "$RELAY_CONF" | head -1)
  relay_token=$(sed -n 's/^token=//p' "$RELAY_CONF" | head -1)
  [[ -z ${relay_port:-} || -z ${relay_token:-} ]] && exit 0
fi

addr_file="$STATE_DIR/$sid"
resolved_marker="$STATE_DIR/$sid.resolved"

# ---- window identity -------------------------------------------------------
# Resolved once per session and cached; a Hyprland window address is stable for
# the window's lifetime. Claude overwrites the title on its next redraw, which
# is fine — the nonce only has to survive one poll.
# Find a terminal to write the title sequence to. /dev/tty is the controlling
# terminal and works whenever the hook has one; if the hook's stdio has been
# redirected we fall back to the tty of an ancestor process, which is the
# agent's own terminal.
kettle_tty() {
  # Must be an actual open, not a -w test: the /dev/tty node is writable by
  # permission even when the process has no controlling terminal, in which case
  # opening it fails with ENXIO. Testing -w here silently picks a tty that
  # cannot be written, and the ancestor fallback below never runs.
  if { : > /dev/tty; } 2>/dev/null; then echo /dev/tty; return 0; fi
  local p=$PPID t
  for _ in 1 2 3 4 5; do
    t=$(ps -o tty= -p "$p" 2>/dev/null | tr -d ' ')
    if [[ -n $t && $t != "?" && -w /dev/$t ]]; then echo "/dev/$t"; return 0; fi
    p=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null) || return 1
    [[ -z $p || $p -le 1 ]] && return 1
  done
  return 1
}

resolve_window() {
  local nonce="kettle:$sid" addr="" tty
  tty=$(kettle_tty) || return 0
  printf '\033]2;%s\007' "$nonce" > "$tty" 2>/dev/null || return 0

  # Poll immediately, then every 50ms: the nonce is visible in ~50ms but the
  # agent repaints its own title on the next frame, so a slow first check
  # loses the race.
  for _ in $(seq 1 30); do
    addr=$(hyprctl clients -j 2>/dev/null | python3 -c "
import json,sys
try: cs=json.load(sys.stdin)
except Exception: sys.exit(0)
for c in cs:
    if c.get('title')==sys.argv[1]:
        print(c['address']); break
" "$nonce" 2>/dev/null)
    [[ -n $addr ]] && break
    sleep 0.05
  done

  if [[ -n $addr ]]; then
    mkdir -p "$STATE_DIR"
    printf '%s' "$addr" > "$addr_file"
  fi
}

if (( REMOTE )); then
  # No hyprctl here — the title is the only thing that crosses ssh, and the
  # relay watches for it on the other side.
  if [[ ! -f $resolved_marker && $state != "gone" ]]; then
    mkdir -p "$STATE_DIR"
    tty=$(kettle_tty) && printf '\033]2;kettle:%s\007' "$sid" > "$tty" 2>/dev/null
  fi
  [[ $state == "gone" ]] && rm -f "$resolved_marker"
  addr=""; focused=false
else

# Resolve lazily rather than only at SessionStart: a session that was already
# running when these hooks were installed never saw a SessionStart, and would
# otherwise never learn its window. Any event will do — the cost is one title
# write that Claude overwrites on its next redraw.
[[ ! -s $addr_file && $state != "gone" ]] && resolve_window

addr=""
[[ -f $addr_file ]] && addr=$(<"$addr_file")

# A cached address is only good while that window exists. Windows close; their
# addresses are never reused, so a stale one would silently focus nothing.
if [[ -n $addr ]] && ! hyprctl clients -j 2>/dev/null | grep -qF "$addr"; then
  rm -f "$addr_file"
  addr=""
  [[ $state != "gone" ]] && resolve_window && { [[ -f $addr_file ]] && addr=$(<"$addr_file"); }
fi

# Whether the user is looking at this session right now. Decided here rather
# than in the widget because the hook already has hyprctl to hand, and the
# widget has no cheap way to learn the focused window's Hyprland address.
# Only needed on completion — every other event is focus-independent.
focused=false
if [[ $state == "finished" && -n $addr ]]; then
  cur=$(hyprctl activewindow -j 2>/dev/null | python3 -c "
import json,sys
try: print(json.load(sys.stdin).get('address',''))
except Exception: pass
" 2>/dev/null)
  [[ -n $cur && $cur == "$addr" ]] && focused=true
fi

[[ $state == "gone" ]] && rm -f "$addr_file"
fi

# ---- session metadata ------------------------------------------------------
# Claude's hook payload has no model or token fields, but it does point at the
# session transcript. Read only the tail: these files reach megabytes, and the
# newest assistant message is always at the end.
# Only the model: the transcript has no field for context-window fill, and the
# cache-read counter is not a stand-in for it — after compaction it exceeds the
# window entirely. A number that reads as "context used" but is not would be
# worse than showing nothing.
# Codex puts the model in the hook payload; Claude does not, so fall back to
# the transcript only when the payload is silent.
model="${payload_model:-}"
if [[ -z $model && -n ${transcript:-} && -f $transcript ]]; then
  model=$(python3 -c '
import json, sys
path = sys.argv[1]
try:
    with open(path, "rb") as f:
        f.seek(0, 2)
        f.seek(max(0, f.tell() - 262144))
        lines = f.read().decode("utf-8", "replace").split("\n")
except Exception:
    print(" "); sys.exit(0)

model = ""; used = 0
for line in reversed(lines):
    if not line.strip():
        continue
    try:
        m = (json.loads(line).get("message") or {})
    except Exception:
        continue
    if not isinstance(m, dict):
        continue
    u = m.get("usage")
    if m.get("model") and isinstance(u, dict):
        model = str(m["model"])
        break

# claude-opus-5 -> opus-5, gpt-5.6-luna -> gpt-5.6-luna
short = model.replace("claude-", "").replace("-20", " ").split(" ")[0]
print(short or "-")
' "$transcript" 2>/dev/null)
  [[ $model == "-" ]] && model=""
fi

# ---- emit ------------------------------------------------------------------
b64=$(python3 -c '
import base64, json, sys
print(base64.b64encode(json.dumps({
    "source":  "agent",
    "agent":   sys.argv[7],
    "id":      sys.argv[1],
    "state":   sys.argv[2],
    "cwd":     sys.argv[3],
    "message": sys.argv[4][:160],
    "window":  sys.argv[5],
    "focused": sys.argv[6] == "true",
    "model":   sys.argv[8],
}).encode()).decode())
' "$sid" "$state" "$cwd" "$message" "$addr" "$focused" "$agent" "${model:-}" 2>/dev/null)

[[ -z $b64 ]] && exit 0

if (( REMOTE )); then
  # The relay replies `ok` once it has resolved this session's window from the
  # nonce; after that we stop repainting the title. `need-nonce` means the
  # window went away (a reattached multiplexer, say) and we must announce again.
  # The token rides an environment variable, not argv: /proc/*/cmdline is
  # world-readable for the process's lifetime, /proc/*/environ is not.
  ( KETTLE_RELAY_TOKEN="$relay_token" python3 -c '
import socket, sys, os
port, b64, marker = sys.argv[1], sys.argv[2], sys.argv[3]
token = os.environ.get("KETTLE_RELAY_TOKEN", "")
try:
    s = socket.create_connection(("127.0.0.1", int(port)), 1)
    s.settimeout(2)
    s.sendall(f"v1 {token} {b64}\n".encode())
    ack = s.recv(64).decode().strip()
    s.close()
except Exception:
    sys.exit(0)          # relay down: drop the event, never stall the agent
if ack == "ok":
    try: open(marker, "w").close()
    except Exception: pass
elif ack == "need-nonce":
    try: os.unlink(marker)
    except Exception: pass
' "$relay_port" "$b64" "$resolved_marker" >/dev/null 2>&1 & ) &
  exit 0
fi

# Fire and forget: a hook must never make the agent wait, and must never fail
# the agent if the shell is not running.
( omarchy-shell kettle agentEvent "$b64" >/dev/null 2>&1 & ) &
exit 0
